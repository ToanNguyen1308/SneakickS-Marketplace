{
  "name": "sneakicks-backend",
  "version": "1.1.0",
  "description": "Backend for SneakickS marketplace MVP (Week 4 — PostgreSQL + JWT + Matching Engine)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/migrate.js --seed-only",
    "db:reset": "node src/db/migrate.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  }
}
