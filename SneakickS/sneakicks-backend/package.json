{
  "name": "sneakicks-backend",
  "version": "2.0.0",
  "description": "Backend for SneakickS marketplace (GR2 — catalog attributes, behavior tracking, market by size)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/migrate.js --seed-only",
    "db:reset": "node src/db/migrate.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5"
  }
}
